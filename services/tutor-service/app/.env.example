PORT=8003
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
# Semantic search model (transformers.js / ONNX build of multilingual-e5-small, 384 dims)
EMBEDDING_MODEL=Xenova/multilingual-e5-small
MODEL_CACHE_DIR=.cache/models
# Fill the embedding of profiles that have none (seed SQL, created while the model was down) on startup
BACKFILL_EMBEDDINGS_ON_START=true
# Relevance rules of the semantic search (cosine distance); see src/domain/searchPolicy.js. Calibrate with: npm run calibrate:search
# SEMANTIC_MIN_SEPARATION=0.025  # best match must be at least this far below the median distance of the catalog
# SEMANTIC_RELATIVE_MARGIN=0.03  # keep results within this distance of the best match
# SEMANTIC_ABSOLUTE_CEILING=0.22 # sanity cap