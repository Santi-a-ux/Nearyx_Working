# Image for Render (free instance: 512 MB RAM). Same as Dockerfile, but the embedding model is downloaded at BUILD
# time (free instances have an ephemeral disk) and the lighter q8 variant is used by default.
FROM node:22-slim
WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY app/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

COPY app/ ./

ARG EMBEDDING_DTYPE=q8
ENV NODE_ENV=production
ENV PORT=8003
ENV MODEL_CACHE_DIR=/app/.cache/models
ENV EMBEDDING_DTYPE=${EMBEDDING_DTYPE}

RUN mkdir -p /app/.cache && node scripts/prefetchModel.js && chown -R node:node /app/.cache

EXPOSE 8003
USER node

CMD ["node", "src/server.js"]
