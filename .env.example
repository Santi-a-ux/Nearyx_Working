# Copia este archivo a .env (NO lo subas a git). Los valores secretos se comparten por un gestor de
# contraseñas, nunca por chat ni por git. Rótalos cuando alguien deje de colaborar.

# ── Base de datos (Supabase, pooler transaction, puerto 6543) ──
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST-DEL-POOLER:6543/postgres

# ── JWT: debe ser EXACTAMENTE el mismo que usan los servicios de Render ──
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://redis:6379

# ── tutor-service: el dtype debe coincidir con el de los embeddings guardados en la DB ──
EMBEDDING_DTYPE=q8
BACKFILL_EMBEDDINGS_ON_START=false
SEMANTIC_MIN_SEPARATION=0.025
SEMANTIC_RELATIVE_MARGIN=0.03
SEMANTIC_ABSOLUTE_CEILING=0.22

# ── Gateway ──
WAKE_KEY=
# Orígenes del navegador permitidos (el front de Render y el front local):
CORS_ORIGINS=http://localhost:3000

# ── Front local (solo con: docker compose --profile frontend up -d --build) ──
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
INTERNAL_API_URL=http://gateway:8000
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_FORCE_MEDELLIN=0
