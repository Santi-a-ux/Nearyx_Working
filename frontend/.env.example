# Variables del front (Vercel: Project -> Settings -> Environment Variables; Production y Preview)
# Las NEXT_PUBLIC_* se incrustan en el build: tras cambiarlas hay que redeployar.

# URL pública del gateway (https, sin barra final). Navegador:
NEXT_PUBLIC_API_URL=https://<tu-gateway>
# La misma URL para las rutas /api/* del servidor de Next:
INTERNAL_API_URL=https://<tu-gateway>

# Host del WebSocket del chat, SIN ruta (la app añade /chat/ws/<id>). Vercel no soporta WebSocket:
# usa el gateway si está en Render, o el chat-service directo (https://<chat>.onrender.com -> wss://<chat>.onrender.com).
NEXT_PUBLIC_WS_URL=wss://<host-del-websocket>

# Token público de Mapbox (restríngelo por URL en el panel de Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxx

# 1 = centrar el mapa en Medellín aunque el usuario esté en otro lugar
NEXT_PUBLIC_FORCE_MEDELLIN=0

# No definas COOKIE_SECURE en Vercel: en producción es true por defecto (HTTPS).
