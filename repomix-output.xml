<file path="frontend/app/globals.css">
@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);

  --font-sans: var(--font-sans);
  --font-mono: var(--font-geist-mono);
  --font-heading: var(--font-heading);
  --font-display: var(--font-display);

  --color-expert: var(--expert);
  --color-student: var(--student);

  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);

  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);

  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);

  --color-destructive: var(--destructive);

  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);

  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);

  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);

  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);

  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);

  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);

  --color-brand-dark: var(--brand-dark);
  --color-brand-hover: var(--brand-hover);
  --color-brand-soft: var(--brand-soft);
  --color-brand: var(--brand-action);

  --color-semantic-success: var(--semantic-success);
  --color-semantic-error: var(--semantic-error);
  --color-semantic-warning: var(--semantic-warning);
  --color-semantic-info: var(--semantic-info);

  --color-neutral-50: var(--neutral-50);
  --color-neutral-100: var(--neutral-100);
  --color-neutral-200: var(--neutral-200);
  --color-neutral-600: var(--neutral-600);
  --color-neutral-700: var(--neutral-700);
  --color-neutral-900: var(--neutral-900);

  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.4);
  --radius-2xl: calc(var(--radius) * 1.8);
  --radius-3xl: calc(var(--radius) * 2.2);
  --radius-4xl: calc(var(--radius) * 2.6);
}

:root {
  /* =========================
     BRAND PALETTE
  ========================== */

  --brand-action: #2563eb;
  --brand-hover: #1d4ed8;
  --brand-soft: #dbeafe;
  --brand-dark: #0f172a;

  --expert: #d97706;
  --student: #059669;

  --neutral-50: #f8fbff;
  --neutral-100: #eef4ff;
  --neutral-200: #d9e3f4;
  --neutral-600: #4b5563;
  --neutral-700: #374151;
  --neutral-900: #282828;

  --accent-sky: #8ec5fc;
  --accent-cream: #fffaf5;
  --accent-peach: #ffe5cf;

  --semantic-success: #16a34a;
  --semantic-error: #dc2626;
  --semantic-warning: #f59e0b;
  --semantic-info: #0284c7;

  /* =========================
     DESIGN SYSTEM TOKENS
  ========================== */

  --bg: #f8fbff;
  --surface-1: #0f172a;
  --surface-2: #162135;
  --surface-3: #1e2b42;
  --surface-hover: #1a2a42;
  --surface: #0f172a;
  --surface2: #162135;

  --text-primary: #f8fbff;
  --text-secondary: rgba(248, 251, 255, 0.72);
  --text-muted: rgba(248, 251, 255, 0.45);

  --color-bg: #f8fbff;
  --color-surface: #0f172a;
  --color-text: #282828;
  --color-text-muted: #4b5563;
  --color-border: rgba(217, 227, 244, 0.72);
  --color-accent: #0058ff;
  --color-accent-dark: #172554;
  --color-accent-light: rgba(0, 88, 255, 0.12);

  --radius: 0.75rem;
  --radius-sm: 8px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-pill: 9999px;

  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
  --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 12px 32px rgba(15, 23, 42, 0.1);
  --shadow: var(--shadow-md);

  /* =========================
     TYPOGRAPHY (Fraunces + Geist)
  ========================== */

  --font-display: var(--font-fraunces), "Fraunces", "Iowan Old Style", Georgia, serif;
  --font-sans: var(--font-geist-sans), "Geist", system-ui, sans-serif;
  --font-body: var(--font-sans);
  --font-heading: var(--font-display);
  --font-main: var(--font-body);
  --font-mono: var(--font-geist-mono), "Geist Mono", ui-monospace, monospace;

  /* =========================
     SHADCN TOKENS
  ========================== */

  --background: #f8fafc;
  --foreground: #0f172a;

  --card: #ffffff;
  --card-foreground: #0f172a;

  --popover: #ffffff;
  --popover-foreground: #0f172a;

  --primary: #2563eb;
  --primary-foreground: #ffffff;

  --secondary: #f1f5f9;
  --secondary-foreground: #0f172a;

  --muted: #f1f5f9;
  --muted-foreground: #475569;

  --accent: #dbeafe;
  --accent-foreground: #1e3a8a;

  --destructive: #dc2626;

  --border: #e2e8f0;
  --border-hover: #cbd5e1;

  --input: #e2e8f0;

  --ring: #2563eb;

  /* =========================
     SIDEBAR
  ========================== */

  --sidebar-width: 220px;
  --sidebar-width-icon: 60px;

  --sidebar: #0f172a;
  --sidebar-foreground: #f8fbff;
  --sidebar-border: rgba(148, 163, 184, 0.28);
  --sidebar-accent: rgba(248, 251, 255, 0.08);
  --sidebar-accent-foreground: #f8fbff;
  --sidebar-primary: #2563eb;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-ring: rgba(96, 165, 250, 0.4);

  /* =========================
     ZONE HELPERS
  ========================== */

  --ui-navbar-bg: #f8fbff;
  --ui-hero-bg: linear-gradient(135deg, #8ec5fc 0%, #d6eaff 55%, #ffe5cf 100%);
  --ui-alt-section-bg: #fffaf5;
  --ui-dark-panel-bg: #0f172a;
  --ui-dark-panel-text: #f8fbff;
}

/* =========================
   DARK MODE — keep light palette
========================== */

.dark,
.landing-dark {
  color-scheme: light;

  --background: #f8fbff;
  --foreground: #282828;

  --card: #ffffff;
  --card-foreground: #282828;

  --popover: #ffffff;
  --popover-foreground: #282828;

  --primary: #0058ff;
  --primary-foreground: #ffffff;

  --secondary: #eef4ff;
  --secondary-foreground: #282828;

  --muted: #f3f6fb;
  --muted-foreground: #4b5563;

  --accent: #eaf1ff;
  --accent-foreground: #172554;

  --destructive: #dc2626;

  --border: #c6e2fe;
  --input: #ffffff;
  --ring: #2563eb;

  --bg: #f8fbff;
  --surface: #0f172a;
  --surface2: #162135;
  --text: #282828;
  --text-muted: #4b5563;
}

/* =========================
   ACCESSIBILITY — HIGH CONTRAST MODE
========================== */

.high-contrast {
  --background: #000000;
  --foreground: #ffffff;

  --card: #000000;
  --card-foreground: #ffffff;

  --popover: #000000;
  --popover-foreground: #ffffff;

  --primary: #ffd400;
  --primary-foreground: #000000;

  --secondary: #000000;
  --secondary-foreground: #ffd400;

  --muted: #111111;
  --muted-foreground: #d4d4d4;

  --accent: #ffd400;
  --accent-foreground: #000000;

  --destructive: #ff5252;

  --border: #ffd400;
  --input: #000000;
  --ring: #ffd400;

  --color-text: #ffffff;
  --color-text-muted: #d4d4d4;
  --color-bg: #000000;
  --color-border: #ffd400;
  --color-accent: #ffd400;
}

.high-contrast,
.high-contrast body {
  background-color: #000000 !important;
  color: #ffffff !important;
}

/* =========================
   Regla general para el alto contraste
========================== */

.high-contrast *:not(:where(.mapbox-host, .mapbox-host *)) {
  background-color: transparent !important;
  background-image: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  color: #ffffff !important;
  border-color: #ffd400 !important;
  outline-color: #ffd400 !important;
  text-shadow: none !important;
  box-shadow: none !important;
}

.high-contrast a,
.high-contrast button {
  text-underline-offset: 3px;
}

/* =========================
   Arreglo para los paneles
========================== */

.high-contrast header,
