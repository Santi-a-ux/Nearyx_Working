type TopicDefinition = {
  token: string;
  label: string;
  keywords: string[];
};

const TOPIC_DEFINITIONS: TopicDefinition[] = [
  {
    token: "programacion",
    label: "Programación",
    keywords: ["programacion", "python", "django", "fastapi", "backend", "frontend", "codigo", "code", "software", "base", "dato", "database", "sql"],
  },
  {
