PORT=8000
# Upstream timeout in ms (the Python gateway used 60 s)
GATEWAY_TIMEOUT_MS=60000
# Production (Vercel/Render): comma separated browser origins allowed by CORS (empty = any origin, dev only)
# CORS_ORIGINS=https://your-app.vercel.app
# Secret for GET /wake?key=... (wakes every service and touches the DB; see DEPLOY_RENDER.md)
# WAKE_KEY=
# Optional overrides; defaults are the docker-compose service names
# AUTH_SERVICE_URL=http://auth-service:8001
# USER_SERVICE_URL=http://user-service:8002
# TUTOR_SERVICE_URL=http://tutor-service:8003
# GEO_SERVICE_URL=http://geo-service:8004
# CHAT_SERVICE_URL=http://chat-service:8005
# MEDIA_SERVICE_URL=http://media-service:8006   (or https://<your-media>.onrender.com)
# BOOKING_SERVICE_URL=http://booking-service:8007